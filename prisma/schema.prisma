generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth ────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  nickname      String?
  visibility    Visibility @default(PRIVATE)
  createdAt     DateTime   @default(now())

  accounts       Account[]
  sessions       Session[]
  records        Record[]
  spaces         Space[]
  collections    Collection[]
  savedTastes    SavedTaste[] @relation("SavedBy")
  savedByOthers  SavedTaste[] @relation("SavedTarget")
  guestbookNotes GuestbookNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── 공간큐브 Core ────────────────────────────────────────────

model Space {
  id              String   @id @default(cuid())
  ownerId         String?
  name            String
  slug            String   @unique
  type            String
  district        String?
  location        String
  tagline         String?
  openingHours    String?
  naverMapUrl     String?
  description     String   @db.Text
  philosophy      String   @db.Text
  ownerMessage    String?  @db.Text
  experienceGuide String?  @db.Text
  spacePoints     String?  @db.Text
  storyItems      Json?
  imageUrl        String?
  ownerName       String?
  ownerPhotoUrl   String?
  ownerBio        String?  @db.Text
  ownerValues     String?  @db.Text
  ownerPlaylistUrl String?
  ownerBlogUrl    String?
  ownerSocialUrl  String?
  spaceTags       Tag[]
  lat             Float?
  lng             Float?
  isActive        Boolean  @default(true)
  isFullyBooked   Boolean  @default(false)
  currentMood     String?
  createdAt       DateTime @default(now())

  owner           User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  records         Record[]
  collectionItems CollectionItem[]
  storySpaces     ContentStorySpace[]
  scans           SpaceScan[]
  waitlistEntries WaitlistEntry[]
  notes           SpaceNote[]
  guestbookNotes  GuestbookNote[]
}

// 디지털 방명록 포스트잇 — 캔버스 위 좌표에 남는 짧은 흔적
model GuestbookNote {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  content   String   @db.VarChar(80)
  x         Float
  y         Float
  rotation  Float    @default(0)
  color     String   @default("#F6E7A8")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model SpaceScan {
  id        String   @id @default(cuid())
  spaceId   String
  scannedAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model Record {
  id         String   @id @default(cuid())
  userId     String
  spaceId    String
  memo       String?  @db.VarChar(120)
  tasteScore Int? // 취향 적합도 1~5 (신규 기록 UX)
  visitedAt  DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tags  RecordTag[]
}

model RecordTag {
  id       String @id @default(cuid())
  recordId String
  tag      Tag

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  spaceId      String
  addedAt      DateTime   @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, spaceId])
}

model SavedTaste {
  id           String   @id @default(cuid())
  userId       String
  targetUserId String
  savedAt      DateTime @default(now())

  user   User @relation("SavedBy",     fields: [userId],       references: [id], onDelete: Cascade)
  target User @relation("SavedTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

// ─── 콘텐츠 레이어 ────────────────────────────────────────────

model ContentStory {
  id          String    @id @default(cuid())
  type        StoryType
  title       String
  slug        String    @unique
  district    String?
  persona     String?
  imageUrl    String?
  intro       String    @db.Text
  body        String    @db.Text
  bodyBlocks  Json?
  cta         String?
  publishedAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storySpaces ContentStorySpace[]
}

model ContentStorySpace {
  id      String @id @default(cuid())
  storyId String
  spaceId String
  order   Int    @default(0)

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  space Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([storyId, spaceId])
}

model SpaceNote {
  id        String   @id @default(cuid())
  spaceId   String
  content   String   @db.VarChar(200)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  spaceId   String
  name      String
  phone     String
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

enum WaitlistStatus {
  WAITING
  CALLED
}

enum StoryType {
  REGION
  TASTE
}

enum Visibility {
  PRIVATE
  PARTIAL
  LINK_ONLY
}

enum Tag {
  QUIET
  INSPIRING
  COMFORTABLE
  UNIQUE
  WANT_AGAIN
  SENSIBLE
  WARM
  FOCUSED
}
