generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth ────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  nickname      String?
  visibility    Visibility @default(PRIVATE)
  createdAt     DateTime   @default(now())

  accounts       Account[]
  sessions       Session[]
  records        Record[]
  spaces         Space[]
  collections    Collection[]
  savedTastes    SavedTaste[] @relation("SavedBy")
  savedByOthers  SavedTaste[] @relation("SavedTarget")
  guestbookNotes GuestbookNote[]
  episodeReads   EpisodeRead[]
  savedSpaces    SavedSpace[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── 공간큐브 Core ────────────────────────────────────────────

model Space {
  id              String   @id @default(cuid())
  ownerId         String?
  name            String
  slug            String   @unique
  type            String
  district        String?
  location        String
  tagline         String?
  openingHours    String?
  naverMapUrl     String?
  description     String   @db.Text
  philosophy      String   @db.Text
  ownerMessage    String?  @db.Text
  experienceGuide String?  @db.Text
  spacePoints     String?  @db.Text
  storyItems      Json?
  imageUrl        String?
  imageZoom       Float?   @default(1)
  imagePositionX  Float?   @default(0.5)
  imagePositionY  Float?   @default(0.5)
  ownerName       String?
  ownerPhotoUrl   String?
  ownerBio        String?  @db.Text
  ownerValues     String?  @db.Text
  ownerPlaylistUrl String?
  ownerBlogUrl    String?
  ownerSocialUrl  String?
  spaceTags       TagKey[] // 레거시 enum 배열 — SpaceTag로 이전 예정, 당분간 병행 유지
  lat             Float?
  lng             Float?
  isActive        Boolean  @default(true)
  isFullyBooked   Boolean  @default(false)
  currentMood     String?
  createdAt       DateTime @default(now())

  owner             User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  records           Record[]
  collectionItems   CollectionItem[]
  storySpaces       ContentStorySpace[]
  scans             SpaceScan[]
  waitlistEntries   WaitlistEntry[]
  notes             SpaceNote[]
  guestbookNotes    GuestbookNote[]
  episodes          Episode[]
  guestbookSettings GuestbookSettings?
  spaceTagLinks     SpaceTag[]
  savedByUsers      SavedSpace[]
}

// 디지털 방명록 포스트잇 — 캔버스 위 좌표에 남는 짧은 흔적
model GuestbookNote {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  content   String   @db.VarChar(80)
  nickname  String? // 작성자 닉네임 (showNickname 설정에 따라 노출)
  imageUrl  String? // 포스트잇 첨부 사진 (allowImage 설정에 따라 허용)
  x         Float
  y         Float
  rotation  Float    @default(0)
  scale     Float    @default(1)
  color     String   @default("#F6E7A8")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId]) // 한 공간에 사용자당 흔적 하나만 — 정책 유지
}

// 공간별 방명록 배경/레이아웃 설정 — 없으면 앱 기본값 사용
model GuestbookSettings {
  spaceId            String   @id
  backgroundType     String   @default("color") // "color" | "image"
  backgroundColor    String?  @default("#F5F1E8")
  backgroundImageUrl String?
  backgroundOpacity  Float    @default(1)
  layoutType         String   @default("scatter") // "scatter" | "grid" 등
  defaultPostitColor String   @default("#F6E7A8")
  initialZoom        Float    @default(1)
  initialX           Float    @default(0)
  initialY           Float    @default(0)
  allowRotation      Boolean  @default(true)
  allowImage         Boolean  @default(false)
  showNickname       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model SpaceScan {
  id        String   @id @default(cuid())
  spaceId   String
  scannedAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model Record {
  id         String   @id @default(cuid())
  userId     String
  spaceId    String
  memo       String?  @db.VarChar(120)
  tasteScore Int? // 취향 적합도 1~5 (신규 기록 UX)
  visitedAt  DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tags  RecordTag[]
}

model RecordTag {
  id       String  @id @default(cuid())
  recordId String
  tag      TagKey // 레거시 enum 값 — 데이터 보존, tagId로 점진 이전
  tagId    String? // 신규 Tag 테이블 참조 (백필 스크립트로 채움, 당분간 nullable)

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  tagRef Tag?   @relation(fields: [tagId], references: [id], onDelete: SetNull)
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  spaceId      String
  addedAt      DateTime   @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, spaceId])
}

model SavedTaste {
  id           String   @id @default(cuid())
  userId       String
  targetUserId String
  savedAt      DateTime @default(now())

  user   User @relation("SavedBy",     fields: [userId],       references: [id], onDelete: Cascade)
  target User @relation("SavedTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

// 사용자가 저장(찜)한 장소 — 동일 공간 중복 저장 불가
model SavedSpace {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
}

// ─── 태그 관리 (관리자 CRUD) ──────────────────────────────────
// 기존 enum Tag는 TagKey로 이름만 변경(@@map으로 DB enum 타입명은 "Tag" 그대로 유지, 데이터 변경 없음).
// 신규 Tag 모델이 관리자 CRUD 가능한 태그 마스터 테이블.

model Tag {
  id                   String    @id @default(cuid())
  name                 String // 관리자가 수정 가능한 표시명 (예: "조용한")
  category             String? // 태그 그룹 (예: "분위기", "용도")
  description          String?
  displayOrder         Int       @default(0)
  isActive             Boolean   @default(true) // 실제 삭제 대신 비활성화
  useForRecommendation Boolean   @default(true)
  legacyKey            TagKey?   @unique // 기존 enum 값과의 매핑 (마이그레이션용, 신규 태그는 null)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  spaceLinks SpaceTag[]
  recordTags RecordTag[]

  @@map("tags")
}

// 공간-태그 연결 + 가중치 (추천 로직에서 활용)
model SpaceTag {
  id             String   @id @default(cuid())
  spaceId        String
  tagId          String
  weight         Float    @default(1)
  isPrimary      Boolean  @default(false)
  visibleToUsers Boolean  @default(true) // 사용자 기록 화면(태그 선택 등)에 노출할지 여부
  createdAt      DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([spaceId, tagId])
  @@map("space_tags")
}

// ─── 스토리(에피소드) 레이어 ──────────────────────────────────
// 공간별 다회차 스토리. 방문 횟수에 따라 잠금 해제되는 여러 Episode,
// 각 Episode는 여러 Scene(텍스트+이미지 블록)으로 구성.

model Episode {
  id               String   @id @default(cuid())
  spaceId          String
  episodeNumber    Int
  title            String
  description      String?  @db.Text
  unlockVisitCount Int      @default(0) // 이 방문 횟수부터 열람 가능 (0 = 항상 공개)
  displayOrder     Int      @default(0)
  published        Boolean  @default(false)
  imageUrl         String?
  imageZoom        Float?   @default(1)
  imagePositionX   Float?   @default(0.5)
  imagePositionY   Float?   @default(0.5)
  imageAspectRatio String?  @default("4/3")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  space  Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  scenes Scene[]
  reads  EpisodeRead[]

  @@unique([spaceId, episodeNumber])
}

model Scene {
  id               String   @id @default(cuid())
  episodeId        String
  title            String?
  content          String   @db.Text
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true) // 비활성화 시 사용자 화면에서 숨김 (삭제 대안)
  imageUrl         String?
  imageZoom        Float?   @default(1)
  imagePositionX   Float?   @default(0.5)
  imagePositionY   Float?   @default(0.5)
  imageAspectRatio String?  @default("3/2")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

// 사용자별 Episode 열람 상태
model EpisodeRead {
  id          String    @id @default(cuid())
  userId      String
  episodeId   String
  openedAt    DateTime  @default(now())
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

// ─── 콘텐츠 레이어 ────────────────────────────────────────────

model ContentStory {
  id          String    @id @default(cuid())
  type        StoryType
  title       String
  slug        String    @unique
  district    String?
  persona     String?
  imageUrl    String?
  intro       String    @db.Text
  body        String    @db.Text
  bodyBlocks  Json?
  cta         String?
  publishedAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storySpaces ContentStorySpace[]
}

model ContentStorySpace {
  id      String @id @default(cuid())
  storyId String
  spaceId String
  order   Int    @default(0)

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  space Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([storyId, spaceId])
}

model SpaceNote {
  id        String   @id @default(cuid())
  spaceId   String
  content   String   @db.VarChar(200)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  spaceId   String
  name      String
  phone     String
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

enum WaitlistStatus {
  WAITING
  CALLED
}

enum StoryType {
  REGION
  TASTE
}

enum Visibility {
  PRIVATE
  PARTIAL
  LINK_ONLY
}

// 레거시 방문자 태그 enum. Prisma 식별자만 TagKey로 변경(신규 Tag 모델과 이름 충돌 회피),
// @@map으로 실제 DB enum 타입명은 "Tag" 그대로 유지 — 기존 컬럼 데이터 변경 없음.
enum TagKey {
  QUIET
  INSPIRING
  COMFORTABLE
  UNIQUE
  WANT_AGAIN
  SENSIBLE
  WARM
  FOCUSED

  @@map("Tag")
}
