generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth ────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  name              String?
  email             String?    @unique
  emailVerified     DateTime?
  image             String?
  nickname          String?    @unique
  // 마지막으로 닉네임을 변경한 시각 — 30일에 1회만 변경 가능한 정책의 서버측 기준.
  // null이면 아직 한 번도 변경(최초 설정 포함)한 적 없다는 뜻으로, 쿨다운 없이 즉시 설정 가능하다.
  nicknameUpdatedAt DateTime?
  visibility        Visibility @default(PRIVATE)
  // 발표·시연용 더미 계정 — 삭제하지 않고 실제 서비스에서만 제외한다(src/lib/demoData.ts).
  // true면 KPI 집계·다른 사용자 목록에서 빠지고, 이 계정의 방명록 흔적은 시연 공간 안에서만 보인다.
  // 관리자 /admin/demo-data에서 해제(false)하면 일반 계정으로 즉시 되돌아간다.
  isDemo            Boolean    @default(false)
  createdAt         DateTime   @default(now())
  // ── 공개 취향 프로필(/@handle) — 내 아카이브(개인 기록)와 같은 데이터를 쓰되, 사용자가 켠 것만 보여준다.
  // 기본은 전부 비공개: 기존 사용자도 자동 공개되지 않는다. 공간은 ProfileSpace로 하나씩 공개한다.
  // (레거시 visibility와 별개 — visibility는 기존 "취향 닮은 사람" 추천에만 쓰인다.)
  profilePublic     Boolean    @default(false)
  // 공유 주소용 고정 핸들(영문 소문자·숫자·._-) — 닉네임(한글, 30일마다 변경 가능)과 분리해 링크가 안정적이다.
  profileHandle     String?    @unique
  profileBio        String?    @db.VarChar(120)
  // 자동 계산된 대표 취향 · 자주 찾는 지역을 프로필에 보일지(숨길 수 있음)
  profileShowTaste  Boolean    @default(true)
  profileShowAreas  Boolean    @default(true)

  accounts              Account[]
  sessions              Session[]
  records               Record[]
  spaces                Space[]
  collections           Collection[]
  savedTastes           SavedTaste[]           @relation("SavedBy")
  savedByOthers         SavedTaste[]           @relation("SavedTarget")
  guestbookNotes        GuestbookNote[]
  episodeReads          EpisodeRead[]
  savedSpaces           SavedSpace[]
  spaceScans            SpaceScan[]
  spaceUnlocks          SpaceUnlock[]
  guestbookReactions    GuestbookReaction[]
  guestbookComments     GuestbookComment[]
  notificationsReceived Notification[]         @relation("NotificationReceiver")
  notificationsSent     Notification[]         @relation("NotificationSender")
  guestbookFunnelEvents GuestbookFunnelEvent[]
  sceneReaches          SceneReach[]
  savedEditorialSpaces  SavedEditorialSpace[]
  // 큐레이터 역할(선택) — 모든 큐레이터는 일반 사용자이고, 일부 사용자만 공개 큐레이터 프로필을 추가로 가진다.
  curatorProfile        CuratorProfile?
  archiveEntries        ArchiveEntry[]
  profileSpaces         ProfileSpace[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── 공간큐브 Core ────────────────────────────────────────────

model Space {
  id               String   @id @default(cuid())
  ownerId          String?
  name             String
  slug             String   @unique
  // DEPRECATED: "공간 유형" 카테고리(Category.name === "공간 유형", SINGLE 선택)에서 고른
  // Tag.name의 캐시일 뿐이다. 표시 화면은 이 값이 아니라 실시간 SpaceTag 조인을 우선 읽어야
  // 한다(resolveSpaceTypeLabel, src/lib/spaceType.ts) — 관리자가 태그 이름을 바꾸면 이 캐시는
  // stale해질 수 있다. NOT NULL 제약 때문에 삭제하지 않고 파생값으로만 유지한다.
  type             String
  district         String?
  location         String
  tagline          String?
  openingHours     String?
  naverMapUrl      String?
  description      String   @db.Text
  philosophy       String   @db.Text
  ownerMessage     String?  @db.Text
  experienceGuide  String?  @db.Text
  spacePoints      String?  @db.Text
  storyItems       Json?
  imageUrl         String?
  imageZoom        Float?   @default(1)
  imagePositionX   Float?   @default(0.5)
  imagePositionY   Float?   @default(0.5)
  ownerName        String?
  ownerPhotoUrl    String?
  ownerBio         String?  @db.Text
  ownerValues      String?  @db.Text
  ownerPlaylistUrl String?
  ownerBlogUrl     String?
  ownerSocialUrl   String?
  spaceTags        TagKey[] // 레거시 enum 배열 — SpaceTag로 이전 예정, 당분간 병행 유지
  lat              Float?
  lng              Float?
  isActive         Boolean  @default(true)
  // 시연·테스트 공간 — 삭제·비공개(isActive=false) 없이 실제 서비스에서만 제외한다(src/lib/demoData.ts).
  // isActive와 독립: isActive=false는 "완전히 닫힘"(QR·직접 링크도 막힘), isDemo=true는 "목록에서만 빠짐"
  // (QR·직접 링크로는 시연 가능, 공개 목록·검색·추천 후보·추천 취향 신호·전체 KPI 합계에서는 제외).
  isDemo           Boolean  @default(false)
  isFullyBooked    Boolean  @default(false)
  currentMood      String?
  createdAt        DateTime @default(now())

  // 공간별 다국어 사용 여부 및 지원 언어 — 둘 다 기본값(false, [])이면 기존 한국어 전용 동작과 완전히 동일
  multilingualEnabled Boolean  @default(false)
  supportedLocales    String[] @default([])

  // 월간 리포트 주기 설정 — 공간큐브 관리자만 설정, 운영자는 조회만 가능
  reportStartDate     DateTime?
  reportTimezone      String    @default("Asia/Seoul")
  reportEnabled       Boolean   @default(false)
  operatorNotifyEmail String?
  operatorNotifyPhone String?

  // 운영자 PIN 인증(/operator) — 계정 연결 없이 "공간 검색 + 4자리 PIN"으로 운영 화면에 접근한다.
  // operatorAccessVersion은 PIN 변경 시 +1 되어, 이미 발급된 운영 세션 쿠키를 전부 즉시 무효화한다.
  operatorPinHash       String?
  operatorPinUpdatedAt  DateTime?
  operatorAccessVersion Int       @default(1)

  // 운영자 자기 정보 — 방문자에게 노출되는 ownerName/ownerBio와는 별개로, 운영자 본인이
  // /operator/[spaceId]/settings에서 직접 관리하는 내부 연락처·리포트 수신 설정.
  operatorContactName        String?
  operatorContactEmail       String?
  operatorReportEmail        String?
  operatorReportEmailEnabled Boolean @default(true)

  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  records               Record[]
  collectionItems       CollectionItem[]
  storySpaces           ContentStorySpace[]
  scans                 SpaceScan[]
  waitlistEntries       WaitlistEntry[]
  notes                 SpaceNote[]
  guestbookNotes        GuestbookNote[]
  episodes              Episode[]
  guestbookSettings     GuestbookSettings?
  spaceTagLinks         SpaceTag[]
  savedByUsers          SavedSpace[]
  kpis                  SpaceKPI[]
  translations          SpaceTranslation[]
  cube                  Cube?
  guestbookSessions     GuestbookSession[]
  monthlyReports        SpaceMonthlyReport[]
  operatorMonthlyNotes  OperatorMonthlyNote[]
  unlocks               SpaceUnlock[]
  guestbookFunnelEvents GuestbookFunnelEvent[]
}

// 공간/에피소드/씬 번역 공통 상태값 — NOT_CREATED는 행이 아예 없는 상태로 표현(별도 값 불필요)
enum TranslationStatus {
  READY
  OUTDATED
  ERROR
}

// 공간 소개/한 줄 설명/운영자 이야기의 언어별 번역본.
// 한국어 원문(Space 테이블)은 그대로 두고 이 테이블에만 번역 결과를 저장한다.
model SpaceTranslation {
  id           String            @id @default(cuid())
  spaceId      String
  locale       String
  tagline      String?
  description  String?           @db.Text
  ownerBio     String?           @db.Text
  status       TranslationStatus @default(READY)
  sourceHash   String? // 번역 시점의 원문 해시 — 원문이 바뀌면 달라져서 OUTDATED 판단에 사용
  errorMessage String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, locale])
  @@map("space_translations")
}

// 방명록 세션 — 기간별로 운영되는 방명록 한 회차. 자유/질문1/질문2 세 군집을 가질 수 있다.
// DRAFT(운영자가 다음 회차 질문·좌표를 준비 중) → ACTIVE(방문자가 실제로 쓸 수 있는 현재 세션)
// → ARCHIVED(종료, 읽기 전용). 공간당 ACTIVE는 1개만 허용(부분 유니크 인덱스로 DB에서 보장,
// migrate-guestbook-sessions.ts 참고 — Prisma 스키마 문법만으로는 표현 불가해 raw SQL로 추가).
enum GuestbookSessionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model GuestbookSession {
  id        String                 @id @default(cuid())
  spaceId   String
  title     String?
  question1 String?
  question2 String?
  startsAt  DateTime?
  endsAt    DateTime?
  status    GuestbookSessionStatus @default(DRAFT)

  // 무한 캔버스 월드 좌표(WORLD_W/WORLD_H = 5000×5000 기준) — 질문이 비어 있으면 해당 군집은 캔버스에 표시하지 않는다.
  freeClusterX      Float @default(2500)
  freeClusterY      Float @default(2500)
  question1ClusterX Float @default(2000)
  question1ClusterY Float @default(2200)
  question2ClusterX Float @default(3000)
  question2ClusterY Float @default(2800)

  // 군집별 표시 여부 — 질문 내용이 있어도 이 값이 false면 방문자 캔버스에 나타나지 않는다
  // (getVisibleClusters가 "내용 존재 && visible" 둘 다 확인). FREE는 이 값으로만 판정한다.
  freeLabelVisible Boolean @default(true)
  question1Visible Boolean @default(true)
  question2Visible Boolean @default(true)

  // 군집별 글자 크기(px, 12~48 허용)/색상(#RRGGBB) — 기본값은 기존 하드코딩 렌더링과
  // 시각적으로 동일하게 역산함(검정 배경 위 rgba(255,255,255,alpha) 지각색 ≈ 채널값 round(255*alpha)).
  freeLabelFontSize Int    @default(14)
  question1FontSize Int    @default(16)
  question2FontSize Int    @default(16)
  freeLabelColor    String @default("#8C8C8C")
  question1Color    String @default("#EBEBEB")
  question2Color    String @default("#EBEBEB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space    Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  notes    GuestbookNote[]
  comments GuestbookComment[]

  @@map("guestbook_sessions")
}

// 포스트잇이 속한 군집 — clusterType은 벽이 아니라 "어떤 질문을 기준으로 썼는지"를 남기는 메타데이터일 뿐,
// 방문자는 저장 후에도 다른 위치로 자유롭게 옮길 수 있다.
enum ClusterType {
  FREE
  QUESTION_1
  QUESTION_2
}

// 디지털 방명록 포스트잇 — 캔버스 위 좌표에 남는 짧은 흔적
// recordId: 이 흔적을 만든 "인정된 방문"(Record, isNewVisit/REVISIT_INTERVAL_HOURS 기준)의 id.
// 방문 1회당 흔적 1개 정책의 핵심 — 세션이 같아도 recordId가 다르면(=재방문이 인정되면) 새로 작성 가능.
// 기존 데이터(세션 도입 이전)에는 대응하는 방문 기록이 없을 수 있어 nullable로 유지한다
// (prisma/migrate-guestbook-visits.ts가 가능한 범위에서 가장 가까운 방문 기록을 backfill).
model GuestbookNote {
  id                 String      @id @default(cuid())
  userId             String?
  // 비로그인 작성자 식별자(src/lib/anonVisitor.ts의 sc_anon_id 쿠키 값) — userId가 null인
  // 행에만 채워진다. EpisodeRead/GuestbookFunnelEvent와 동일한 이중 nullable 패턴.
  anonId             String?
  spaceId            String
  guestbookSessionId String
  recordId           String?
  clusterType        ClusterType @default(FREE)
  content            String      @db.VarChar(80)
  nickname           String? // 작성자 닉네임 (showNickname 설정에 따라 노출)
  imageUrl           String? // 포스트잇 첨부 사진 (allowImage 설정에 따라 허용)
  x                  Float
  y                  Float
  rotation           Float       @default(0)
  scale              Float       @default(1)
  color              String      @default("#F6E7A8")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  // 운영자 방명록 관리(/operator/[spaceId]/guestbook) — 숨김은 가역적, 삭제는 소프트 삭제
  // (복구 UI 없음). 방문자 화면(진행 중/아카이브 캔버스) 쿼리에서는 둘 다 제외해야 한다.
  isHidden  Boolean   @default(false)
  hiddenAt  DateTime?
  deletedAt DateTime?

  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  space   Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  session GuestbookSession @relation(fields: [guestbookSessionId], references: [id], onDelete: Cascade)
  record  Record?          @relation(fields: [recordId], references: [id], onDelete: SetNull)

  reactions     GuestbookReaction[]
  featuredIn    MonthlyReportFeaturedPost[]
  comments      GuestbookComment[]
  notifications Notification[]

  // 같은 방문 기록으로 같은 세션에 흔적을 두 번 남길 수 없다 — "방문 1회당 흔적 1개".
  // recordId가 null인 레거시 행끼리는 NULL이 서로 달라 취급되어(Postgres 유니크 인덱스 규칙)
  // 이 제약에 걸리지 않는다.
  @@unique([userId, guestbookSessionId, recordId])
  // 비로그인 작성자용 "방문 1회당 흔적 1개" — anonId는 12시간마다 새로 발급되므로 이 자체가
  // 이미 방문 단위 경계 역할을 한다(recordId 없이도 동일한 정책을 표현).
  @@unique([anonId, guestbookSessionId])
}

// 방명록 포스트잇 공감 — 좋아요/랭킹이 아니라 "공감"으로만 노출. 포스트잇당 1회(로그인은 userId,
// 비로그인은 anonId 기준 — sc_anon_id 쿠키, GuestbookNote와 동일 패턴).
model GuestbookReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  anonId    String?
  createdAt DateTime @default(now())

  post GuestbookNote @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, anonId])
  @@index([postId])
  @@index([userId])
  @@map("guestbook_reactions")
}

// 포스트잇 댓글 — 1단계 답글만 허용(대댓글 없음). 본인만 수정/삭제 가능.
// guestbookSessionId/recordId: 작성 당시 노트의 세션(note.guestbookSessionId를 그대로 복사)과
// 작성자의 인정된 방문 기록 — "방문 1회당 댓글 1개"를 세션 단위로 제약하기 위한 필드.
// 어느 포스트잇에 댓글을 달든 같은 방문으로는 하나만 허용되므로 노트가 아니라 여기(댓글 자체)에 저장한다.
model GuestbookComment {
  id                 String   @id @default(cuid())
  guestbookId        String
  userId             String?
  // 비로그인 작성자 식별자(sc_anon_id) — userId가 null인 행에만 채워진다.
  anonId             String?
  guestbookSessionId String?
  recordId           String?
  content            String   @db.VarChar(200)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  note          GuestbookNote     @relation(fields: [guestbookId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       GuestbookSession? @relation(fields: [guestbookSessionId], references: [id], onDelete: Cascade)
  record        Record?           @relation(fields: [recordId], references: [id], onDelete: SetNull)
  notifications Notification[]

  // 같은 방문 기록으로는 (어느 포스트잇이든) 댓글 하나만 — guestbookSessionId/recordId가
  // 둘 다 null인 레거시 댓글끼리는 NULL 규칙상 서로 충돌하지 않는다.
  @@unique([guestbookSessionId, userId, recordId])
  // 비로그인 작성자용 "방문 1회당 답글 1개" — anonId가 방문 단위 경계 역할을 한다.
  @@unique([guestbookSessionId, anonId])
  @@index([guestbookId])
  @@map("guestbook_comments")
}

enum NotificationType {
  LIKE
  COMMENT
}

// 내 포스트잇에 달린 공감/댓글 알림 — SNS 피드가 아니라 "새 반응이 생겼다"는 정도의 단순 알림.
model Notification {
  id          String           @id @default(cuid())
  receiverId  String
  senderId    String
  type        NotificationType
  guestbookId String
  commentId   String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  receiver User              @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender   User              @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  note     GuestbookNote     @relation(fields: [guestbookId], references: [id], onDelete: Cascade)
  comment  GuestbookComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
  @@map("notifications")
}

// 공간별 방명록 배경/레이아웃 설정 — 없으면 앱 기본값 사용
model GuestbookSettings {
  spaceId            String   @id
  backgroundType     String   @default("color") // "color" | "image"
  backgroundColor    String?  @default("#F5F1E8")
  backgroundImageUrl String?
  backgroundOpacity  Float    @default(1)
  layoutType         String   @default("scatter") // "scatter" | "grid" 등
  defaultPostitColor String   @default("#F6E7A8")
  initialZoom        Float    @default(1)
  initialX           Float    @default(0)
  initialY           Float    @default(0)
  allowRotation      Boolean  @default(true)
  allowImage         Boolean  @default(false)
  showNickname       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model SpaceScan {
  id        String   @id @default(cuid())
  spaceId   String
  scannedAt DateTime @default(now())

  // 큐브 QR(/c/[code]) 경유 스캔에서만 채워지는 부가 정보 — 개인정보 최소화를 위해
  // IP는 저장하지 않고, userId도 로그인 상태였을 때만 채운다.
  cubeId    String?
  userId    String?
  // 비로그인 스캔의 방문자 식별자(sc_anon_id 쿠키, EpisodeRead/GuestbookFunnelEvent와 동일한
  // 값 재사용) — "QR 진입자 수(고유 방문자)"를 Story View와 같은 기준으로 비교하기 위해 추가.
  // 스캔 자체는 여러 번 발생할 수 있으므로 유니크 제약을 두지 않는다(원시 스캔 로그는 그대로 유지).
  anonId    String?
  userAgent String? @db.VarChar(300)
  referrer  String? @db.VarChar(300)
  locale    String?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  cube  Cube? @relation(fields: [cubeId], references: [id], onDelete: SetNull)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// 큐브 QR 연결 상태 — 미등록/연결됨/비활성화
enum CubeStatus {
  UNASSIGNED
  ASSIGNED
  DISABLED
}

// 큐브별 고유 QR과 공간의 연결 정보. 공간마다 QR을 새로 만드는 대신,
// 큐브를 미리 여러 개 만들어두고 실제 설치 시점에 공간과 연결한다.
// spaceId를 @unique로 둬서 "공간 하나엔 큐브 하나만" 정책을 DB 제약으로 보장한다.
model Cube {
  id     String     @id @default(cuid())
  code   String     @unique // 예: GC-001, 생성 후 변경 불가
  status CubeStatus @default(UNASSIGNED)

  spaceId String? @unique
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  scans   SpaceScan[]
  unlocks SpaceUnlock[]

  @@map("cubes")
}

// 공간 이야기(Episode/Scene/방명록)를 열람할 권한 그 자체 — 취향 점수를 남기는 Record와는
// 별개 개념이다. 반드시 해당 공간에 연결된 유효한 Cube QR(/c/[code] → ASSIGNED 상태 확인)을
// 실제로 인식했을 때만 생성되며, 카드 클릭이나 URL 직접 접근으로는 생성되지 않는다.
// 한 사용자·한 공간 조합은 유일하다 — 재스캔해도 새 행을 만들지 않고 unlockedAt만 갱신한다.
model SpaceUnlock {
  id         String   @id @default(cuid())
  userId     String
  spaceId    String
  // 어떤 큐브로 열었는지 기록(감사 추적용). 큐브가 나중에 재연결/삭제돼도 이미 부여된
  // 열람 권한 자체는 유지해야 하므로 onDelete는 SetNull — 잠금 해제 여부는 이 행의 존재
  // 자체로 판정하지, cube 관계의 생존 여부로 재검증하지 않는다.
  cubeId     String?
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  cube  Cube? @relation(fields: [cubeId], references: [id], onDelete: SetNull)

  @@unique([userId, spaceId])
  @@index([spaceId])
}

// 공간별 KPI 일별 스냅샷 — 관리자 KPI 화면이 매번 다시 계산하지 않도록
// 이벤트(기록 생성/수정, 방명록 작성) 발생 시 그날 날짜(KST 기준)의 행을 재계산해 저장한다.
// date 기준으로 누적되므로 추후 월별 리포트는 이 테이블을 월 단위로 묶어서 만들 수 있다.
model SpaceKPI {
  id      String   @id @default(cuid())
  spaceId String
  date    DateTime @db.Date // KST 기준 집계일

  qrUsersToday Int @default(0) // 오늘 방문 기록을 남긴 고유 사용자 수
  qrUsersMonth Int @default(0) // 이번 달 방문 기록을 남긴 고유 사용자 수
  qrUsersTotal Int @default(0) // 누적 방문 기록을 남긴 고유 사용자 수

  revisitUsersTotal Int   @default(0) // 12시간 재방문 정책 기준 재방문자 수 (누적)
  revisitRate       Float @default(0) // revisitUsersTotal / qrUsersTotal (0~1)

  guestbookUsersTotal Int   @default(0) // 방명록 작성자 수 (누적)
  guestbookRate       Float @default(0) // guestbookUsersTotal / qrUsersTotal (0~1)
  totalGuestbookCount Int   @default(0) // 누적 포스트잇 수

  averageTasteScore Float? // 취향 적합도(1~5) 평균, 기록 없으면 null
  tasteScoreCount   Int    @default(0) // 평균 계산에 쓰인 기록 수 (월별 가중평균용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, date])
  @@map("space_kpi")
}

// 월간 리포트 상태 — COLLECTING(진행 중, DB에 저장하지 않고 매번 라이브 계산)은 문서화 목적으로만 존재.
// READY는 "생성됐지만 아직 미공개" 확장을 위해 예약된 값으로, 현재 워크플로우에서는 실제로 쓰지 않는다
// (생성 즉시 PUBLISHED로 저장 — 완료 보고에서 다시 설명).
enum MonthlyReportStatus {
  COLLECTING
  READY
  PUBLISHED
}

// 공간별 월간 리포트 — 확정된 스냅샷. 공개된 이후 원본 데이터가 바뀌어도 이 행의 숫자는 그대로 유지된다.
// 같은 기간이 중복 생성되지 않도록 @@unique([spaceId, periodStart])로 idempotent 보장.
// ReportEmail.tsx가 그대로 렌더링할 수 있도록, 규칙 기반으로 생성한 문장(headline/changeInsights/
// suggestions)과 파생 집계(질문별 참여 등)까지 전부 이 시점에 스냅샷으로 굳혀서 저장한다 — 특히
// reactionsTotal/질문 참여 수는 이후에도 계속 바뀔 수 있는 값이라(공감은 계속 늘어남) 매번 새로
// 계산하면 "확정된 스냅샷" 원칙이 깨진다.
model SpaceMonthlyReport {
  id          String              @id @default(cuid())
  spaceId     String
  periodStart DateTime
  periodEnd   DateTime
  status      MonthlyReportStatus @default(PUBLISHED)
  publishedAt DateTime?

  qrUsers           Int
  returningUsers    Int
  revisitRate       Float
  guestbookWriters  Int
  guestbookPosts    Int
  guestbookRate     Float
  averageTasteScore Float?
  usageSummary      String @db.Text

  // 확장 지표 — 태그 기반 KPI(방문자 취향 TOP3/공간 사용 방식)를 대체하는 신규 리포트 구조용.
  qrScans                Int     @default(0) // 원시 QR 스캔 수(SpaceScan, 로그인 여부 무관)
  episodeViews           Int     @default(0) // 기간 내 최초 열람된 Episode 수(EpisodeRead.openedAt 기준)
  episodeCompletions     Int     @default(0) // 위 조회 중 실제로 완독(마지막 섹션 도달)까지 간 수
  avgReadDurationMs      Int? // 기간 내 스토리 페이지 평균 체류시간(ms), 표본 없으면 null
  newlyUnlockedEpisodes  Int     @default(0) // 기간 내 방문으로 새로 해제된 Episode 수(episodeState 로직 재사용)
  reactionsTotal         Int     @default(0) // 기간 내 작성된 포스트잇에 달린 공감 총합(스냅샷 시점 고정)
  tasteScoreDistribution Json? // [{ score: 1~5, count }]
  questionParticipation  Json? // [{ type, label, count, percent }] — 자유/질문1/질문2
  headline               String? @db.Text // "① 이번 달 한눈에 보기" 규칙 기반 요약 문장
  changeInsights         Json? // string[] — "③ 이번 달 변화"
  suggestions            Json? // string[] (최대 2개) — "⑦ 다음 달 제안"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space         Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  featuredPosts MonthlyReportFeaturedPost[]
  operatorNotes OperatorMonthlyNote[]

  @@unique([spaceId, periodStart])
  @@map("space_monthly_reports")
}

// 월간 리포트 공개 시점의 공감 TOP3 스냅샷 — 이후 공감이 더 생겨도 리포트에 표시되는 TOP3는 고정된다.
model MonthlyReportFeaturedPost {
  id              String   @id @default(cuid())
  monthlyReportId String
  guestbookNoteId String
  rank            Int // 1~3
  reactionCount   Int // 생성 시점의 공감 수 스냅샷
  createdAt       DateTime @default(now())

  report SpaceMonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  note   GuestbookNote      @relation(fields: [guestbookNoteId], references: [id], onDelete: Cascade)

  @@unique([monthlyReportId, rank])
  @@map("monthly_report_featured_posts")
}

// 운영자가 리포트별로 남기는 비공개 메모 — 공간+리포트당 공유 메모 1개(PIN 접근에는 개별 로그인
// 사용자가 없으므로 운영자 단위가 아니라 공간 단위로 공유한다). 해당 공간의 운영 PIN을 아는 사람만 조회 가능.
model OperatorMonthlyNote {
  id              String   @id @default(cuid())
  monthlyReportId String   @unique
  spaceId         String
  content         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  report SpaceMonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  space  Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("operator_monthly_notes")
}

model Record {
  id         String   @id @default(cuid())
  userId     String
  spaceId    String
  memo       String?  @db.VarChar(120)
  tasteScore Int? // 취향 적합도 1~5 (신규 기록 UX)
  visitedAt  DateTime @default(now())

  // 파일럿 최소 계측 — 이번 방문(Record)이 해당 화면에 실제로 도달한 최초 시각(선택, 1회만 기록).
  // 새 이벤트 테이블 대신 이미 "방문 1건"을 대표하는 이 행에 직접 얹는다.
  guestbookViewedAt      DateTime?
  recommendationViewedAt DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tags  RecordTag[]

  guestbookNotes    GuestbookNote[]
  guestbookComments GuestbookComment[]

  // 사용자×공간별 "가장 최근 방문" 조회(추천/취향 프로파일, 재방문 판정)가 빈번해 추가.
  @@index([userId, spaceId, visitedAt])
}

model RecordTag {
  id       String  @id @default(cuid())
  recordId String
  tag      TagKey // 레거시 enum 값 — 데이터 보존, tagId로 점진 이전
  tagId    String? // 신규 Tag 테이블 참조 (백필 스크립트로 채움, 당분간 nullable)

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  tagRef Tag?   @relation(fields: [tagId], references: [id], onDelete: SetNull)
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  spaceId      String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, spaceId])
}

// 취향 따라가기(user-facing: "취향 따라가기" / "따라가는 취향") — userId가 targetUserId의 공간 취향을 계속 참고한다.
// 기존 "이 취향 저장하기"(/taste/[userId])와 같은 관계라 새 모델을 만들지 않고 재사용한다. 일반 사용자·큐레이터 공통.
model SavedTaste {
  id           String   @id @default(cuid())
  userId       String
  targetUserId String
  savedAt      DateTime @default(now())

  user   User @relation("SavedBy", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("SavedTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

// 사용자가 저장(찜)한 장소 — 동일 공간 중복 저장 불가
model SavedSpace {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
}

// ─── 태그 관리 (관리자 CRUD) ──────────────────────────────────
// 기존 enum Tag는 TagKey로 이름만 변경(@@map으로 DB enum 타입명은 "Tag" 그대로 유지, 데이터 변경 없음).
// 신규 Tag 모델이 관리자 CRUD 가능한 태그 마스터 테이블.

// 카테고리 선택 방식 — SINGLE(예: 공간 유형)은 공간당 해당 카테고리 태그를 1개만,
// MULTI(예: 분위기·추천 활동)는 여러 개 선택할 수 있다. SpaceForm·space-tags PUT 양쪽에서
// enforceSingleSelectCategories(src/lib/tagLinks.ts)로 서버단에 강제한다.
enum CategorySelectionType {
  SINGLE
  MULTI
}

// 태그 카테고리 — Tag.category(자유 텍스트)를 실제 엔티티로 승격한 것.
// prisma/migrate-tag-categories.ts가 기존 문자열 값들을 이 테이블로 백필한다.
model Category {
  id            String                @id @default(cuid())
  name          String                @unique // 예: "공간 유형", "분위기"
  selectionType CategorySelectionType @default(MULTI)
  description   String?
  displayOrder  Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tags Tag[]

  @@map("categories")
}

model Tag {
  id                   String   @id @default(cuid())
  name                 String // 관리자가 수정 가능한 표시명 (예: "조용한")
  category             String? // 레거시 자유 텍스트 카테고리 — 더 이상 쓰지 않음(categoryId로 대체), 롤백 안전망으로만 컬럼 보존
  categoryId           String? // 신규: Category 참조 (nullable — 미분류 태그 허용)
  description          String?
  displayOrder         Int      @default(0)
  isActive             Boolean  @default(true) // 실제 삭제 대신 비활성화
  useForRecommendation Boolean  @default(true)
  legacyKey            TagKey?  @unique // 기존 enum 값과의 매핑 (마이그레이션용, 신규 태그는 null)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categoryRef Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  spaceLinks  SpaceTag[]
  recordTags  RecordTag[]

  @@map("tags")
}

// 공간-태그 연결 + 가중치 (추천 로직에서 활용)
model SpaceTag {
  id             String   @id @default(cuid())
  spaceId        String
  tagId          String
  weight         Float    @default(1)
  isPrimary      Boolean  @default(false)
  visibleToUsers Boolean  @default(true) // 사용자 기록 화면(태그 선택 등)에 노출할지 여부
  createdAt      DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([spaceId, tagId])
  @@map("space_tags")
}

// ─── 지역(공간 둘러보기 SVG 지도) ─────────────────────────────
// ACTIVE=선명 표시+클릭 시 줌인 후 이동, COMING_SOON=흐리게 표시+클릭 시 안내만,
// HIDDEN=사용자 화면 미노출(관리자 화면에는 계속 보임).
enum DistrictStatus {
  ACTIVE
  COMING_SOON
  HIDDEN
}

// 둘러보기 지도 위 지역 프리셋. SVG 도형(배경 격자/한강 등)은 코드에 고정돼 있고,
// 관리자는 마커 위치·줌 설정·노출 상태만 편집한다(도형 자체는 관리자 편집 대상이 아님).
// name은 Space.district(자유 문자열 컬럼)와 값으로 매칭되는 조인 키다 — 별도 FK 관계를
// 두지 않고 문자열 일치로만 연결하며(Space.district 쪽 데이터 형식을 그대로 존중),
// slug는 관리자 식별/향후 확장용으로만 저장할 뿐 현재 라우팅(/discover?district=name)에는
// 쓰이지 않는다.
model District {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  status    DistrictStatus @default(HIDDEN)
  order     Int            @default(0)
  tagline   String?
  // SVG viewBox "0 0 310 390" 기준 좌표
  markerX   Float          @default(155)
  markerY   Float          @default(195)
  zoomX     Float          @default(155)
  zoomY     Float          @default(195)
  zoomScale Float          @default(1.8)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("districts")
}

// ─── 스토리(에피소드) 레이어 ──────────────────────────────────
// 공간별 다회차 스토리. 방문 횟수에 따라 잠금 해제되는 여러 Episode,
// 각 Episode는 여러 Scene(텍스트+이미지 블록)으로 구성.

model Episode {
  id               String   @id @default(cuid())
  spaceId          String
  episodeNumber    Int
  title            String
  description      String?  @db.Text
  summary          String?  @db.Text // 한 줄 요약(선택) — 이야기의 핵심 문장, 본문에서 자동 추출하지 않음
  unlockVisitCount Int      @default(0) // 이 방문 횟수부터 열람 가능 (0 = 항상 공개)
  displayOrder     Int      @default(0)
  published        Boolean  @default(false)
  isFeatured       Boolean  @default(false) // QR 스캔 직후 바로 진입시킬 "대표 이야기" — 공간당 최대 1개
  imageUrl         String?
  imageZoom        Float?   @default(1)
  imagePositionX   Float?   @default(0.5)
  imagePositionY   Float?   @default(0.5)
  imageAspectRatio String?  @default("4/3")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  space        Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  scenes       Scene[]
  reads        EpisodeRead[]
  translations EpisodeTranslation[]

  @@unique([spaceId, episodeNumber])
}

// 공간큐브 전용 인터뷰 질문 라이브러리 — 실제 방문자 페이지의 Episode/Scene과는 완전히 분리된
// 제작 보조 도구다(어느 쪽도 서로를 참조하는 FK가 없음). "에피소드 템플릿 → Scene 소재 → 질문"
// 3단 구조로, 콘텐츠 제작 시 이번 에피소드에 어떤 소재로 인터뷰할지 미리 구성해둔다.
// 특정 공간에도 종속되지 않는 공용 라이브러리 — 질문지 생성 시 공간을 고르지만 그 선택은
// 텍스트 치환용일 뿐 어떤 관계 테이블에도 저장되지 않는다.
model InterviewEpisodeTemplate {
  id            String   @id @default(cuid())
  episodeNumber Int      @unique
  title         String
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sceneTopics InterviewSceneTopic[]

  @@map("interview_episode_templates")
}

// 에피소드 템플릿을 구성하는 Scene 소재 — 여기서의 title/description은 관리자 내부 분류명일 뿐,
// 실제 게시되는 Scene.title/content와 자동으로 연결하거나 복사하지 않는다.
model InterviewSceneTopic {
  id                String   @id @default(cuid())
  episodeTemplateId String
  title             String
  description       String?  @db.Text
  isRequired        Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  episodeTemplate InterviewEpisodeTemplate @relation(fields: [episodeTemplateId], references: [id], onDelete: Cascade)
  questions       InterviewQuestion[]

  @@map("interview_topics")
}

// Scene 소재 아래 딸린 질문 — 질문지 생성 화면의 무작위/수동 선택 대상.
// isActive=false는 소프트 비활성화로, 선택 대상에서만 제외되고 삭제되지 않는다.
model InterviewQuestion {
  id           String   @id @default(cuid())
  topicId      String
  content      String   @db.Text
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic InterviewSceneTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("interview_questions")
}

// 에피소드 제목/부제(description)의 언어별 번역본
model EpisodeTranslation {
  id           String            @id @default(cuid())
  episodeId    String
  locale       String
  title        String?
  subtitle     String?           @db.Text
  status       TranslationStatus @default(READY)
  sourceHash   String?
  errorMessage String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, locale])
  @@map("episode_translations")
}

model Scene {
  id               String   @id @default(cuid())
  episodeId        String
  title            String?
  content          String   @db.Text
  summary          String?  @db.Text // 한 줄 요약 — 방문자 화면에서 본문 아래 강조 문장으로 표시(선택, 본문에서 자동 추출 안 함)
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true) // 비활성화 시 사용자 화면에서 숨김 (삭제 대안)
  imageUrl         String?
  imageZoom        Float?   @default(1)
  imagePositionX   Float?   @default(0.5)
  imagePositionY   Float?   @default(0.5)
  imageAspectRatio String?  @default("3/2")
  // "cover"(기본, 비율에 맞춰 채우고 자름) | "contain"(원본 전체를 보여주고 남는 영역은 배경색으로 채움).
  // 세로 사진처럼 어떻게 잘라도 의미가 훼손되는 경우를 위한 선택지 — null인 기존 행은 "cover"와 동일하게 취급한다.
  imageFit         String?  @default("cover")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  episode      Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  translations SceneTranslation[]
  images       SceneImage[]
  reaches      SceneReach[]
}

// Story Depth 분석 — 한 방문(로그인/비로그인 공통)에서 이 Scene에 실제로 스크롤해 도달했는지
// 최초 1회만 기록한다(EpisodeRead/GuestbookFunnelEvent와 동일한 "몇 번"이 아니라 "몇 명" 근사:
// (userId, sceneId) 또는 (anonId, sceneId) 유니크 제약으로 같은 방문자가 반복 스크롤/새로고침해도
// 중복 행이 생기지 않는다). Scene 1은 Story View(EpisodeRead)와 사실상 동시에 발생해 중복이므로
// 애초에 기록하지 않는다(SceneReadingProgress.tsx, 2번째 Scene부터만 이벤트를 보낸다).
// 관리자 계정은 API 라우트(POST /api/scenes/[sceneId]/reach)가 세션을 확인해 아예 행을 쓰지
// 않으므로(EpisodeRead와 동일한 패턴) 여기에는 관리자 제외용 필터가 별도로 필요 없다.
model SceneReach {
  id        String   @id @default(cuid())
  sceneId   String
  userId    String?
  anonId    String? // 비로그인 방문자 식별자(sc_anon_id 쿠키, EpisodeRead와 동일한 값 재사용)
  reachedAt DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sceneId])
  @@unique([anonId, sceneId])
  @@index([sceneId, reachedAt])
}

// Scene당 여러 장(최대 3장, UI에서 제한) 지원 — imageUrl/imageZoom/imagePositionX/Y/imageAspectRatio/
// imageFit(위)은 이 모델 도입 이전의 단일 이미지 레거시 필드로 그대로 남겨둔다: 어떤 Scene도 이
// 테이블에 행이 없으면 방문자 화면이 자동으로 그 레거시 필드 기준(기존 cover/contain 렌더링)으로
// 표시한다 — 기존 데이터는 손대지 않고, 관리자가 이 Scene에 새 다중 이미지 UI로 실제로 편집할
// 때만(예: 두 번째 사진 추가) 이 테이블에 행이 생긴다. width/height는 ImageCropDialog가 잘라낸
// 결과의 실제 픽셀 크기를 그대로 저장한 것 — 방문자 화면에서 이미지 로드 전에도 서버에서 바로
// 정확한 비율/크기로 레이아웃을 계산할 수 있게 한다(레이아웃 시프트 방지, 재크롭 없이 원본 비율 유지).
model SceneImage {
  id           String   @id @default(cuid())
  sceneId      String
  imageUrl     String
  width        Int
  height       Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

// Scene 제목/본문(content)의 언어별 번역본 — "에피소드 본문"의 실제 저장 단위
model SceneTranslation {
  id           String            @id @default(cuid())
  sceneId      String
  locale       String
  title        String?
  content      String?           @db.Text
  summary      String?           @db.Text // Scene.summary(한 줄 요약)의 번역본
  status       TranslationStatus @default(READY)
  sourceHash   String?
  errorMessage String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, locale])
  @@map("scene_translations")
}

// 사용자별/익명 방문자별 Episode 열람 상태 — userId(로그인) 또는 anonId(비로그인, sc_anon_id
// 쿠키)로 대상을 구분한다. 정확히 하나만 채워지며, Postgres 유니크 인덱스는 NULL을 서로
// 다른 값으로 취급하므로 두 @@unique가 서로 간섭하지 않는다(로그인 행은 anonId=null이 여러 개
// 있어도, 비로그인 행은 userId=null이 여러 개 있어도 각각 정상).
model EpisodeRead {
  id          String    @id @default(cuid())
  userId      String?
  anonId      String? // 비로그인 방문자 식별자(src/lib/anonVisitor.ts의 sc_anon_id 쿠키 값)
  episodeId   String
  openedAt    DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int? // 클라이언트가 페이지를 벗어날 때 sendBeacon으로 보고하는 체류시간(ms)

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@unique([anonId, episodeId])
}

// 방명록 퍼널(Story → Guestbook → Login → Post-it) 이탈 지점 계측 — 사용자/익명 방문자당
// 스텝별 최초 1회만 기록한다(EpisodeRead와 동일한 근사: "몇 번" 대신 "몇 명"을 센다). 실제
// Post-it 작성은 이 테이블에 넣지 않고 기존 GuestbookNote를 그대로 KPI에 쓴다.
enum GuestbookFunnelStep {
  ENTRY_ATTEMPT // 방명록/기록 페이지 방향으로 이동을 시도함(로그인/비로그인 공통, 최초로 관측 가능한 지점)
  WRITE_ATTEMPT // 방명록 캔버스 안에서 "작성" 버튼을 눌러 작성모드에 진입함(로그인/비로그인 공통)
  LOGIN_REQUIRED // 비로그인 상태로 방명록/기록 흐름을 타다 로그인 요구 화면을 실제로 봄
  LOGIN_SUCCESS // 위 로그인 요구를 받았던 익명 방문자가 실제로 로그인을 완료함
  GUESTBOOK_VIEWED // 방명록 캔버스가 실제로 렌더됨(로그인/비로그인 공통) — 첫 방문 흐름 단순화 이후 추가
  EXPERIENCE_COMPLETE // 완료 페이지(/space/[slug]/complete)에 도달함(로그인/비로그인 공통)
}

model GuestbookFunnelEvent {
  id        String              @id @default(cuid())
  spaceId   String
  userId    String?
  anonId    String? // 비로그인 방문자 식별자(sc_anon_id 쿠키, EpisodeRead와 동일한 값 재사용)
  step      GuestbookFunnelStep
  createdAt DateTime            @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId, step])
  @@unique([anonId, spaceId, step])
  @@index([spaceId, step, createdAt])
}

// ─── 콘텐츠 레이어 ────────────────────────────────────────────

model ContentStory {
  id          String    @id @default(cuid())
  type        StoryType
  title       String
  slug        String    @unique
  district    String?
  persona     String?
  imageUrl    String?
  intro       String    @db.Text
  body        String    @db.Text
  bodyBlocks  Json?
  cta         String?
  publishedAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storySpaces ContentStorySpace[]
}

model ContentStorySpace {
  id      String @id @default(cuid())
  storyId String
  spaceId String
  order   Int    @default(0)

  story ContentStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  space Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([storyId, spaceId])
}

model SpaceNote {
  id        String   @id @default(cuid())
  spaceId   String
  content   String   @db.VarChar(200)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  spaceId   String
  name      String
  phone     String
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

enum WaitlistStatus {
  WAITING
  CALLED
}

// ─── 관리자 자료 (PDF) ────────────────────────────────────────
// 설치 안내서/소개 자료 등 PDF를 관리자가 올리면 운영자에게 바로 전달할 공개 링크가 생긴다.
// Space/Cube/Episode 등 기존 도메인과 무관한 독립 모델.
model Material {
  id               String   @id @default(cuid())
  title            String
  // 공개 링크 경로(/materials/{slug}.pdf)에 쓰는 영문 slug — Cloudinary 도메인이 아니라
  // 우리 도메인으로 보이는 링크를 운영자에게 전달하기 위해 별도로 둔다.
  slug             String   @unique
  fileUrl          String
  storageKey       String   @unique
  originalFileName String
  fileSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum StoryType {
  REGION
  TASTE
}

enum Visibility {
  PRIVATE
  PARTIAL
  LINK_ONLY
}

// 레거시 방문자 태그 enum. Prisma 식별자만 TagKey로 변경(신규 Tag 모델과 이름 충돌 회피),
// @@map으로 실제 DB enum 타입명은 "Tag" 그대로 유지 — 기존 컬럼 데이터 변경 없음.
enum TagKey {
  QUIET
  INSPIRING
  COMFORTABLE
  UNIQUE
  WANT_AGAIN
  SENSIBLE
  WARM
  FOCUSED

  @@map("Tag")
}

// ─── 홈페이지 Editorial CMS ────────────────────────────────────────────
// 일반 홈페이지(발견 영역: /spaces · /curation · /people · 홈)의 공개 콘텐츠.
// 현장 Cube 운영 시스템(Space/Cube/Episode/Scene/Guestbook/Record/KPI 등)과 완전히 분리된
// 별도 데이터다 — 아래 모델들은 기존 모델과 어떤 관계(FK)도 갖지 않고, 기존 모델도 이들을
// 참조하지 않는다. "공간 콘텐츠"(EditorialSpace)는 운영 공간(Space)과 무관하며 Cube가
// 없는 공간도 등록할 수 있다. 본문 블록은 JSON(blocks)으로 저장하고 서버에서 검증한다
// (src/lib/editorial/input.ts).

enum EditorialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EditorialCurationPerspective {
  SITUATION
  PURPOSE
}

// 콘텐츠 제작 파이프라인(내부 전용) — 공개 여부는 여전히 EditorialStatus(PUBLISHED만 공개)가 정한다.
// stage는 팀의 진행 단계일 뿐이며, PUBLISHED 단계로 옮기면 status도 PUBLISHED로 함께 바뀐다
// (src/lib/editorial/pipeline.ts가 둘을 항상 맞춘다). 단계는 건너뛸 수 있다(PEOPLE이 아니면 CONTACTING 생략 등).
enum EditorialStage {
  IDEA
  CONTACTING
  PRODUCING
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum EditorialPriority {
  HIGH
  MEDIUM
  LOW
}

model EditorialSpace {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  area          String
  category      String
  summary       String?         @db.Text
  description   String?         @db.Text // 문단은 빈 줄로 구분
  coverImage    String?
  coverPosition String? // CSS object-position, 예: "50% 50%"
  images        String[]        @default([])
  tags          String[]        @default([])
  address       String?
  openingHours  String?
  mapUrl        String?
  instagram     String?
  website       String?
  // 실제 GONGGANCUBE 설치 여부 — 안내 문구 표시용 boolean일 뿐, 운영 공간(Space)/Cube와 연결하지 않는다.
  cubeAvailable Boolean         @default(false)
  // 함께한 공간(cubeAvailable)의 "운영자 전체 이야기" — 웹 정본. 블록 JSON(curation/people과 같은 형식).
  // 현장 Cube의 Episode(1~2분 현장 디테일)와는 별개이며 서로 참조하지 않는다.
  story         Json            @default("[]")
  // 큐레이터 프로토타입용 가상 공간 — 공개 화면·검색·큐레이션·추천·홈에서 항상 제외되고, 관리자/로컬
  // 미리보기의 큐레이터 프로토타입 화면에서만 보인다(src/lib/curators/access.ts). 데모 정책(Space.isDemo)과 같은 원칙.
  isDemo        Boolean         @default(false)
  status        EditorialStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  curationLinks  EditorialCurationSpace[]
  personLinks    EditorialPersonSpace[]
  thoughtLinks   EditorialThoughtSpace[]
  homeHeroOf     EditorialHomeSettings[]  @relation("EditorialHomeHero")
  saves          SavedEditorialSpace[]
  curatorPicks   CuratorCollectionSpace[]
  archiveEntries ArchiveEntry[]
  profileSpaces  ProfileSpace[]

  @@index([status])
  @@map("editorial_spaces")
}

model EditorialCuration {
  id               String                        @id @default(cuid())
  slug             String                        @unique
  number           Int                           @unique // "CURATION 001"
  // 지역(예: "문래") — 현재 주 운영 방식은 "지역 × 하나의 관점"이지만, 지역과 무관한 주제형
  // 큐레이션도 가능하도록 선택값으로 둔다.
  area             String?
  // 큐레이션 관점 — 지역 × 상황(SITUATION) 또는 지역 × 취향·목적(PURPOSE). null은 아직 미지정.
  perspective      EditorialCurationPerspective?
  title            String
  summary          String                        @db.Text
  coverImage       String?
  coverPosition    String?
  blocks           Json                          @default("[]")
  status           EditorialStatus               @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  // ── 제작 관리(내부 전용, 공개 화면에 내보내지 않는다) ──
  // 기존 행은 이미 본문이 있는 초안이므로 기본값을 PRODUCING으로 둔다(빠른 아이디어는 IDEA로 명시 생성).
  stage            EditorialStage                @default(PRODUCING)
  priority         EditorialPriority             @default(MEDIUM)
  assignee         String? // 담당자 이름(팀 권한 시스템 없이 간단한 텍스트)
  scheduledAt      DateTime? // 발행 예정일(자동 발행 없음 — 백로그에서 확인)
  internalNote     String?                       @db.Text
  referenceLinks   String[]                      @default([])
  instagramSummary String?                       @db.Text

  spaces         EditorialCurationSpace[]
  homeFeaturedOf EditorialHomeSettings[]  @relation("EditorialHomeCuration")

  @@index([status])
  @@map("editorial_curations")
}

// 큐레이션 ↔ 공간 콘텐츠 연결(순서 포함). 공간 삭제는 Restrict — 사용 중인 공간은 지울 수 없다.
model EditorialCurationSpace {
  id         String  @id @default(cuid())
  curationId String
  spaceId    String
  order      Int     @default(0)
  note       String?

  curation EditorialCuration @relation(fields: [curationId], references: [id], onDelete: Cascade)
  space    EditorialSpace    @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([curationId, spaceId])
  @@index([spaceId])
  @@map("editorial_curation_spaces")
}

model EditorialPerson {
  id               String            @id @default(cuid())
  slug             String            @unique
  number           Int               @unique // "PEOPLE 001"
  title            String
  subject          String? // 소개 대상(이름 또는 호칭) — 인터뷰이
  subjectRole      String? // 역할·직함(선택) — 예: "북눅 연남 운영자"
  subjectLink      String? // 인스타그램·외부 링크(선택)
  summary          String            @db.Text
  coverImage       String?
  coverPosition    String?
  blocks           Json              @default("[]")
  status           EditorialStatus   @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // ── 제작 관리(내부 전용, 공개 화면에 내보내지 않는다) ──
  // 기존 행은 이미 본문이 있는 초안이므로 기본값을 PRODUCING으로 둔다(빠른 아이디어는 IDEA로 명시 생성).
  stage            EditorialStage    @default(PRODUCING)
  priority         EditorialPriority @default(MEDIUM)
  assignee         String? // 담당자 이름(팀 권한 시스템 없이 간단한 텍스트)
  scheduledAt      DateTime? // 발행 예정일(자동 발행 없음 — 백로그에서 확인)
  internalNote     String?           @db.Text
  referenceLinks   String[]          @default([])
  instagramSummary String?           @db.Text

  spaces EditorialPersonSpace[]

  @@index([status])
  @@map("editorial_people")
}

model EditorialPersonSpace {
  id       String  @id @default(cuid())
  personId String
  spaceId  String
  order    Int     @default(0)
  note     String?

  person EditorialPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  space  EditorialSpace  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([personId, spaceId])
  @@index([spaceId])
  @@map("editorial_person_spaces")
}

// STORY › THOUGHT — 실제 장면에서 시작해 하나의 질문·생각으로 넓혀 가는 에디토리얼.
// PEOPLE(EditorialPerson)과 같은 형태지만 번호 체계("THOUGHT 001")가 따로라 별도 모델로 둔다.
model EditorialThought {
  id               String            @id @default(cuid())
  slug             String            @unique
  number           Int               @unique // "THOUGHT 001"
  title            String
  // 이야기가 시작된 장면·장소(선택) — 예: "비 오는 오후의 서점"
  scene            String?
  summary          String            @db.Text
  coverImage       String?
  coverPosition    String?
  blocks           Json              @default("[]")
  status           EditorialStatus   @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // ── 제작 관리(내부 전용, 공개 화면에 내보내지 않는다) ──
  // 기존 행은 이미 본문이 있는 초안이므로 기본값을 PRODUCING으로 둔다(빠른 아이디어는 IDEA로 명시 생성).
  stage            EditorialStage    @default(PRODUCING)
  priority         EditorialPriority @default(MEDIUM)
  assignee         String? // 담당자 이름(팀 권한 시스템 없이 간단한 텍스트)
  scheduledAt      DateTime? // 발행 예정일(자동 발행 없음 — 백로그에서 확인)
  internalNote     String?           @db.Text
  referenceLinks   String[]          @default([])
  instagramSummary String?           @db.Text

  spaces EditorialThoughtSpace[]

  @@index([status])
  @@map("editorial_thoughts")
}

model EditorialThoughtSpace {
  id        String  @id @default(cuid())
  thoughtId String
  spaceId   String
  order     Int     @default(0)
  note      String?

  thought EditorialThought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  space   EditorialSpace   @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([thoughtId, spaceId])
  @@index([spaceId])
  @@map("editorial_thought_spaces")
}

// ─── 개인 공간 아카이브 ────────────────────────────────────────────────
// User → ArchiveEntry(사용자 × 공간 하나) → ArchiveVisit(방문 여러 번) / ArchivePhoto(사진 여러 장).
// 사진·링크로 "이 공간 좋았는데"를 몇 초 만에 남기는 개인 기록. 전부 PRIVATE — 다른 사용자·공개 화면에 나가지 않는다.
// - 공간큐브에 있는 공간이면 canonical EditorialSpace(spaceId)에 연결하고 새 공간을 만들지 않는다(사용자당 공간당 1개).
// - 없는 공간은 공개 공간으로 등록하지 않고 이 행에만 이름·지역·링크로 남긴다(spaceId=null). placeKey(정규화한
//   이름+지역)로 여러 사용자의 같은 장소를 나중에 묶고, 관리자 검수·외부 장소 매칭 후 spaceId를 채워 승격한다.
// - 공개 저장(SavedEditorialSpace)·Cube 방문(Record)은 그대로 두고, 아카이브 화면에서 공간 기준으로 합쳐 보여준다.

enum ArchiveEntryStatus {
  SAVED // 가보고 싶어요
  VISITED // 다녀왔어요
}

enum ArchiveSourceKind {
  PHOTO // 사진에서 추가
  NAVER_PLACE
  INSTAGRAM
  KAKAO_MAP
  GOOGLE_MAPS
  WEB // 기타 링크
  MANUAL // 이름만 / 공간큐브 안에서
}

model ArchiveEntry {
  id         String             @id @default(cuid())
  userId     String
  // 공간큐브 공개 공간과 연결된 경우(없으면 개인 기록 전용 공간)
  spaceId    String?
  // 표시용 이름·지역 — 연결된 공간이 있어도 사용자가 입력한 값을 남긴다(공간이 보관·삭제돼도 기록은 남도록)
  placeName  String
  placeArea  String?
  // 같은 장소 병합 키(normalizePlaceKey) — 미연결 기록끼리 묶거나 canonical 공간으로 승격할 때 쓴다
  placeKey   String
  status     ArchiveEntryStatus @default(SAVED)
  sourceKind ArchiveSourceKind  @default(MANUAL)
  // 붙여넣은 외부 링크(네이버 플레이스·인스타그램 등) — 내용은 가져오지 않고 주소만 저장
  sourceUrl  String?
  // 나의 한 줄
  memo       String?            @db.VarChar(200)
  // 사용자가 직접 고른 취향 태그(기존 공통 태그 이름) — 명시적 취향 신호
  tags       String[]           @default([])
  wantAgain  Boolean?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  space  EditorialSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  visits ArchiveVisit[]
  photos ArchivePhoto[]

  // 같은 공개 공간은 사용자당 하나의 기록(방문은 ArchiveVisit으로 쌓는다). spaceId가 null인 개인 기록은 제약 없음.
  @@unique([userId, spaceId])
  @@index([userId, updatedAt])
  @@index([placeKey])
  @@map("archive_entries")
}

model ArchiveVisit {
  id        String    @id @default(cuid())
  entryId   String
  // 방문 날짜(모르면 null — 기록한 날짜만 남는다)
  visitedOn DateTime?
  memo      String?   @db.VarChar(200)
  createdAt DateTime  @default(now())

  entry  ArchiveEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  photos ArchivePhoto[]

  @@index([entryId])
  @@map("archive_visits")
}

// 사용자가 직접 올린 사진 — 기본 PRIVATE(소유자 화면에서만 표시). 서버 서명 업로드로 사용자 폴더에만 올라간다.
model ArchivePhoto {
  id        String   @id @default(cuid())
  entryId   String
  visitId   String?
  url       String
  width     Int?
  height    Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  entry ArchiveEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  visit ArchiveVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@map("archive_photos")
}

// ─── 큐레이터 프로토타입 ───────────────────────────────────────────────
// User → (선택) CuratorProfile → CuratorCollection → (canonical) EditorialSpace.
// 큐레이터는 별도 계정 유형이 아니다 — 저장·방문·아카이브·추천을 똑같이 쓰는 User가 공개 프로필과 컬렉션을
// 추가로 가질 뿐이다("모든 사람은 공간을 찾는 사용자이고, 그중 일부가 취향을 공개적으로 공유한다"). 공간은 복제하지 않고 연결만 한다 —
// 한 공간을 여러 큐레이터·컬렉션이 함께 고를 수 있다. 공간큐브 공식 CURATION(EditorialCuration)과는
// 출처가 다른 별개 데이터다(합치지 않음). ENABLE_CURATOR_PROTOTYPE 꺼짐 = 관리자/로컬 미리보기 전용.
// 향후 Instagram 가져오기: 게시물 → 공간 매칭 → CuratorCollectionSpace(sourceUrl) 로 붙이면 된다.

enum CuratorSourceType {
  MANUAL
  INSTAGRAM
}

model CuratorProfile {
  id              String            @id @default(cuid())
  // 이 프로필의 주인(일반 User). 사용자 1명당 프로필 1개.
  userId          String            @unique
  slug            String            @unique
  name            String
  // 한 줄 소개("혼자 오래 머무를 수 있는 작은 카페와 서점을 기록합니다")
  bio             String            @db.Text
  imageUrl        String?
  // 대표 취향(큐레이터 스스로/운영자가 정한 단어) — 분석 수치가 아니라 선언된 취향
  tasteTags       String[]          @default([])
  instagramHandle String?
  instagramUrl    String?
  websiteUrl      String?
  sourceType      CuratorSourceType @default(MANUAL)
  // 공간큐브 공식 큐레이터 계정
  isOfficial      Boolean           @default(false)
  displayOrder    Int               @default(0)
  status          EditorialStatus   @default(DRAFT)
  // 가상의 프로토타입 큐레이터 — 관리자/로컬 미리보기에서만 보인다
  isDemo          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections CuratorCollection[]

  @@index([status])
  @@map("curator_profiles")
}

model CuratorCollection {
  id           String          @id @default(cuid())
  curatorId    String
  slug         String          @unique
  title        String
  description  String          @db.Text
  // 지역(선택) — "연남", "서울" 등. 지역 무관 컬렉션도 가능
  area         String?
  // 상황·목적 키워드(예: 혼자, 비 오는 날, 책) — 찾기·설명에 쓰인다
  keywords     String[]        @default([])
  coverImage   String?
  displayOrder Int             @default(0)
  status       EditorialStatus @default(DRAFT)
  isDemo       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  curator CuratorProfile           @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  spaces  CuratorCollectionSpace[]

  @@index([curatorId])
  @@index([status])
  @@map("curator_collections")
}

// 컬렉션 ↔ 공간(canonical EditorialSpace) — 큐레이터가 왜 골랐는지 한 줄 코멘트와 순서.
model CuratorCollectionSpace {
  id           String   @id @default(cuid())
  collectionId String
  spaceId      String
  comment      String?  @db.Text
  displayOrder Int      @default(0)
  // 향후 Instagram 가져오기 시 원본 게시물 주소(지금은 쓰지 않음)
  sourceUrl    String?
  createdAt    DateTime @default(now())

  collection CuratorCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  space      EditorialSpace    @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([collectionId, spaceId])
  @@index([spaceId])
  @@map("curator_collection_spaces")
}

// 공개 공간(EditorialSpace) 저장 — "나중에 가보고 싶은 공간". 운영 공간 저장(SavedSpace)과 별개이며
// 아카이브·추천에서 slug로 함께 보여준다. 공간 콘텐츠는 영구 삭제 전 참조 검사에서 저장 여부도 본다.
model SavedEditorialSpace {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  space EditorialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("saved_editorial_spaces")
}

// 홈 노출 설정(단일 행, id = "home"). 홈 레이아웃은 코드에 두고 "무엇을 노출할지"만 관리한다.
model EditorialHomeSettings {
  id                 String   @id @default("home")
  heroSpaceId        String?
  featuredCurationId String?
  featuredSpaceIds   String[] @default([]) // 공간 둘러보기(순서대로)
  feed               Json     @default("[]") // 최근 이야기: [{ kind: "curation"|"person"|"space", id, headline? }]
  updatedAt          DateTime @updatedAt

  heroSpace        EditorialSpace?    @relation("EditorialHomeHero", fields: [heroSpaceId], references: [id], onDelete: SetNull)
  featuredCuration EditorialCuration? @relation("EditorialHomeCuration", fields: [featuredCurationId], references: [id], onDelete: SetNull)

  @@map("editorial_home_settings")
}

// ─── 공개 취향 프로필: 공개한 공간 ─────────────────────────────────────────
// 사용자가 "공개 프로필에 보이기"를 켠 canonical 공간(EditorialSpace) 하나. 공간을 복제하지 않는다.
// 내 아카이브에 실제로 있는 공간(저장·방문)일 때만 공개 화면에 나온다(아카이브에서 지우면 자동으로 안 보임).
// 개인 기록(공간큐브에 없는 장소)은 공개할 수 없다. 메모·방문 날짜는 공개하지 않고, 사진은 showPhotos일 때만.
model ProfileSpace {
  id         String   @id @default(cuid())
  userId     String
  spaceId    String
  showPhotos Boolean  @default(false)
  createdAt  DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  space EditorialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("profile_spaces")
}
