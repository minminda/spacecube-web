# Database
# Neon(PostgreSQL) 연결 문자열
DATABASE_URL=

# NextAuth (Google OAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth (Kakao OAuth) — 카카오 디벨로퍼스 콘솔에서 (1) 카카오 로그인 활성화 (2) Redirect URI에
# {AUTH_URL}/api/auth/callback/kakao 등록 (3) 동의항목에서 "카카오계정(이메일)" 필수 동의 설정
# (4) 실서비스로 임의 사용자 이메일을 받으려면 비즈니스 앱 전환 + 카카오 심사 필요.
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 배포 도메인 (예정: https://gonggancube.com, 현재는 https://spacecube-web.vercel.app) — NextAuth 콜백 및 QR/공유 링크 생성에 사용
AUTH_URL=

# 관리자 이메일 화이트리스트 (쉼표로 구분)
ADMIN_EMAIL=

# 공개 앱 URL — OG 메타데이터, QR/공유 링크 생성에 사용 (AUTH_URL과 동일한 값). gonggancube.com 구매 후
# 이 값만 https://gonggancube.com 으로 바꾸면 코드 수정 없이 새 도메인으로 전환된다(src/lib/config.ts 참고).
NEXT_PUBLIC_APP_URL=

# OpenAI (공간/에피소드 다국어 번역 생성)
OPENAI_API_KEY=

# Cloudinary (방명록 포스트잇 사진, 공간/에피소드/스토리 이미지 업로드)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Vercel Cron이 /api/cron/monthly-reports 호출 시 사용하는 인증 토큰 (Authorization: Bearer)
CRON_SECRET=

# ── 파일럿 기능 축소 플래그 (src/lib/pilotFlags.ts) ──────────────────────────
# 값이 없으면 전부 비활성(false)이 기본. 다시 켜려면 해당 값을 "true"로 설정 후 재배포.
# 코드/데이터는 보존하고 UI 노출·불필요한 API/Cron/외부호출만 끈다.
ENABLE_REPORT_EMAIL=false          # 월간 리포트 자동 이메일 발송 + cron 자동 생성/발송
ENABLE_GUESTBOOK_IMAGE=false       # 방명록 포스트잇 사진 첨부(업로드·표시, Cloudinary 호출)
ENABLE_GUESTBOOK_COMMENTS=false    # 방명록 포스트잇 댓글(작성·표시)
ENABLE_NOTIFICATIONS=false         # 공감/댓글 알림(벨·목록·알림 생성) — 공감 자체는 유지
ENABLE_REPORT_AI_ANALYSIS=false    # 리포트 자동 해설/제안 문구(수치·공감 TOP3·참여도는 유지)
ENABLE_MULTILINGUAL=false          # 공간/에피소드 다국어(언어 전환·번역 조회·번역 생성 OpenAI 호출)
