# Database
# Neon(PostgreSQL) 연결 문자열
DATABASE_URL=

# NextAuth (Google OAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 배포 도메인 (예: https://spacecube-web.vercel.app) — NextAuth 콜백 및 QR/공유 링크 생성에 사용
AUTH_URL=

# 관리자 이메일 화이트리스트 (쉼표로 구분)
ADMIN_EMAIL=

# 공개 앱 URL — OG 메타데이터, QR/공유 링크 생성에 사용 (AUTH_URL과 동일한 값)
NEXT_PUBLIC_APP_URL=

# OpenAI (공간/에피소드 다국어 번역 생성)
OPENAI_API_KEY=

# Cloudinary (방명록 포스트잇 사진, 공간/에피소드/스토리 이미지 업로드)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Vercel Cron이 /api/cron/monthly-reports 호출 시 사용하는 인증 토큰 (Authorization: Bearer)
CRON_SECRET=
