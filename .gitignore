# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# handwriting PoC (EXPERIMENTAL, local-only) — vendored third-party source, venv,
# pretrained weights, and scratch output are not app code and shouldn't be committed.
# See handwriting-service/README.md for how to regenerate them locally.
/handwriting-service/dmfont-src/
/handwriting-service/venv/
/handwriting-service/checkpoints/
/handwriting-service/fonts/
/handwriting-service/smoke_out/
/handwriting-service/uvicorn*.log
/handwriting-service/**/__pycache__/
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
